<UserControl
    x:Class="Tm.Ant.Module.Rework.Views.UnitShield"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="5">
        <Button Command="{Binding ToggleSfcCommand}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="Red" />
                    <Setter Property="Content" Value="SFC：已关闭" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SfcEnabled}" Value="True">
                            <Setter Property="Background" Value="Green" />
                            <Setter Property="Content" Value="SFC：已开启" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <GroupBox
            Header="需拆穴位（SFC关闭时）"
            Margin="0,10,0,0"
            IsEnabled="{Binding CanSelectCaves}">
            <GroupBox.Style>
                <Style TargetType="GroupBox">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CanSelectCaves}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </GroupBox.Style>
            <StackPanel>
                <ItemsControl ItemsSource="{Binding TestCaves}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Number}" IsChecked="{Binding Selected}" Margin="3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="应用需拆穴位" Command="{Binding ApplyTestCavesCommand}" />
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
