<UserControl x:Class="Tm.Ant.Module.Rework.Views.UnitShield"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tm.Ant.Module.Rework.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel VerticalAlignment="Center" >
            <Button Content="SFC" MinWidth="100" x:Name="btnSfc" Click="btnSfc_Click" />
            <Button Content="Fake Mode" MinWidth="100" x:Name="btnFake" Margin="0 20 0 0" Click="btnFake_Click" Visibility="Collapsed"/>
            <GroupBox x:Name="testCaveGroup" Margin="0 40 0 0" Header="模拟调重工接口拆指定螺丝">
                <WrapPanel  x:Name="wpCave">
                    <CheckBox>1</CheckBox>
                    <CheckBox>2</CheckBox>
                    <CheckBox>3</CheckBox>
                    <CheckBox>4</CheckBox>
                    <CheckBox>5</CheckBox>
                    <CheckBox>6</CheckBox>
                    <CheckBox>7</CheckBox>
                    <CheckBox>8</CheckBox>
                </WrapPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</UserControl>
