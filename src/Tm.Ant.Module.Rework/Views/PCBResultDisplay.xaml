<UserControl x:Class="Tm.Ant.Module.Rework.Views.PCBResultDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tm.Ant.Module.Rework.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"> 
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0 0 0 10" HorizontalAlignment="Center">
            <TextBlock x:Name="_tbProductCode" FontSize="24" Foreground="Blue"/> 
            <WrapPanel Visibility="Collapsed">
                <TextBox x:Name="tbIndex" MinWidth="75"/>
                <Button Content="正常合格" Background="Green" Height="23" Width="75" Click="Button_Click" Tag="OK"/>
                <Button Content="待加工" Background="Blue" Height="23" Width="75" Margin="20 0 20 0" Click="Button_Click" Tag="WAIT"/>
                <Button Content="不合格" Background="Red" Height="23" Width="75" Click="Button_Click" Tag="NG"/>
            </WrapPanel>
        </WrapPanel>
        <!-- Canvas 作为地图容器 -->
        <Canvas Name="MapCanvas" Grid.Row="1">
            <!-- 背景图片 -->
            <Canvas.Background>
                <ImageBrush ImageSource="../Images/PCB.png" Stretch="Uniform" />
            </Canvas.Background>
        </Canvas>
     
    </Grid>
</UserControl>
