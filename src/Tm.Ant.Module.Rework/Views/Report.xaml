<UserControl x:Class="Tm.Ant.Module.Rework.Views.Report"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:tm="http://tm.com"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--查询条件-->
        <WrapPanel Grid.Row="0" Margin="10">
            <TextBlock Text="开始时间: " VerticalAlignment="Center" Margin="10"/>
            <DatePicker  Width="215"  Text="{Binding SelectDate,Mode=TwoWay}"/>
            <TextBlock Text="ProductCode:" Margin="20 0 0 0" VerticalAlignment="Center"/>
            <TextBox x:Name="tbProductCode" VerticalAlignment="Center" MinWidth="215" Height="23" Margin="5 0 5 0"/>
            <Button
                Content="Query"
                Command="{Binding QueryData}"
                CommandParameter="{Binding ElementName=tbProductCode,Path=Text}"
                IsEnabled="{Binding IsBusy,Converter={x:Static tm:CommonConverters.Boolean2BooleanReConverter}}" />
        </WrapPanel>
        <DataGrid Grid.Row="1" hc:DataGridAttach.CanUnselectAllWithBlankArea="True" HeadersVisibility="All" 
                  RowHeaderWidth="60" AutoGenerateColumns="False" ItemsSource="{Binding DataList}">
            <DataGrid.Columns>
                <DataGridTextColumn IsReadOnly="True" Width="80" CanUserResize="False" Binding="{Binding Id}" Header="Id"/>
                <DataGridTextColumn Binding="{Binding ProductCode}" Header="ProductCode" Width="0.5*"/>
                <DataGridTextColumn Binding="{Binding UnScrewCaves}" Header="Caves" Width="0.8*"/>
                <DataGridTextColumn Binding="{Binding ResultJson}" Header="Result" Width="0.5*"/>
                <DataGridTextColumn Binding="{Binding CreateTime}" Header="StartTime" Width="0.7*"/>
                <DataGridTextColumn Binding="{Binding UpdateTime}" Header="EndTime" Width="0.7*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Border
            Grid.Row="1"
            Panel.ZIndex="2"
            Opacity="0.7"
            Background="LightGray"
            Visibility="{Binding IsBusy,Converter={x:Static tm:CommonConverters.Boolean2VisibilityConverter}}">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"
                       Text="Loading..." Foreground="Red"/>
        </Border>
    </Grid>
</UserControl>
