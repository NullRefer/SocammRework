<UserControl
    x:Class="Tm.Ant.Module.Rework.Views.Report"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tm="http://tm.com">
    <DockPanel Margin="10">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="开始日期" VerticalAlignment="Center" />
            <DatePicker SelectedDate="{Binding SelectDate}" Margin="5" />
            <TextBlock Text="结束日期" VerticalAlignment="Center" />
            <DatePicker SelectedDate="{Binding EndDate}" Margin="5" />
            <TextBlock Text="产品码" VerticalAlignment="Center" />
            <TextBox Text="{Binding ProductCode}" MinWidth="200" Margin="5" />
            <Button
                Content="查询"
                Command="{Binding QueryDataCommand}" />
        </WrapPanel>
        <tm:TmPagination DockPanel.Dock="Bottom" Pagination="{Binding Pagination}" />
        <DataGrid ItemsSource="{Binding Pagination.Rows}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                <DataGridTextColumn Header="产品码" Binding="{Binding ProductCode}" Width="*" />
                <DataGridTextColumn Header="需拆标记" Binding="{Binding UnScrewCaves}" Width="*" />
                <DataGridTextColumn Header="位置" Binding="{Binding Locations}" Width="*" />
                <DataGridTextColumn Header="穴位结果" Binding="{Binding ResultJson}" Width="2*" />
                <DataGridTextColumn Header="已下线(1)" Binding="{Binding IsDeleted}" Width="90" />
                <DataGridTextColumn Header="上料时间" Binding="{Binding CreateTime}" Width="170" />
                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdateTime}" Width="170" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
