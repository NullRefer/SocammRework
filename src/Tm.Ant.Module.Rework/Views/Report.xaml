<UserControl x:Class="Tm.Ant.Module.Rework.Views.Report"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:hc="https://handyorg.github.io/handycontrol"
                xmlns:localCon="clr-namespace:Tm.Ant.Module.Rework.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <localCon:BoolVisibilityConverter x:Key="boolToVis"/>
        <localCon:BoolReConverter x:Key="boolRe"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--查询条件-->
        <WrapPanel Grid.Row="0" Margin="10">
            <DatePicker  Width="215"  Text="{Binding SelectDate,Mode=TwoWay}"/>
            <ComboBox  Margin="5 0" SelectedIndex="{Binding SelectTimeIndex,Mode=TwoWay}">
                <ComboBoxItem>08:00-08:00</ComboBoxItem>
                <ComboBoxItem>08:00-20:00</ComboBoxItem>
                <ComboBoxItem>20:00-08:00</ComboBoxItem>
            </ComboBox>
            <TextBlock Text="ProductCode:" Margin="20 0 0 0" VerticalAlignment="Center"/>
            <TextBox x:Name="tbProductCode" VerticalAlignment="Center" MinWidth="215" Height="23" Margin="5 0 5 0"/>
            <Button Content="Query" Command="{Binding QueryData}" CommandParameter="{Binding ElementName=tbProductCode,Path=Text}" IsEnabled="{Binding IsBusy,Converter={StaticResource boolRe}}"/>
        </WrapPanel>
        <DataGrid Grid.Row="1" hc:DataGridAttach.CanUnselectAllWithBlankArea="True" HeadersVisibility="All" 
                  RowHeaderWidth="60" AutoGenerateColumns="False" ItemsSource="{Binding DataList}">
            <DataGrid.Columns>
                <DataGridTextColumn IsReadOnly="True" Width="80" CanUserResize="False" Binding="{Binding Id}" Header="Id"/>
                <DataGridTextColumn Binding="{Binding ProductCode}" Header="ProductCode" Width="0.5*"/>
                <DataGridTextColumn Binding="{Binding UnScrewCaves}" Header="Caves" Width="0.8*"/>
                <DataGridTextColumn Binding="{Binding Locations}" Header="Locations" Width="*"/>
                <DataGridTextColumn Binding="{Binding FinalResult}" Header="Result" Width="0.5*"/>
                <DataGridTextColumn Binding="{Binding CreateTime}" Header="StartTime" Width="0.7*"/>
                <DataGridTextColumn Binding="{Binding UpdateTime}" Header="EndTime" Width="0.7*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="1" Panel.ZIndex="2" Opacity="0.7" Background="LightGray" Visibility="{Binding IsBusy,Converter={StaticResource boolToVis}}">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"
                       Text="Loading..." Foreground="Red"/>
        </Border>
    </Grid>
</UserControl>
