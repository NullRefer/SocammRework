<UserControl
    x:Class="Tm.Ant.Module.Rework.Views.Report"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tm="http://tm.com"
    xmlns:hc="https://handyorg.github.io/handycontrol">
    <DockPanel Margin="10">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <tm:TmTimeRangeSelector StartTime="{Binding StartTime}" EndTime="{Binding EndTime}" />
            <hc:TextBox
                MinWidth="240"
                Margin="12,0"
                hc:TitleElement.Title="产品码"
                hc:TitleElement.TitlePlacement="Left"
                hc:TitleElement.HorizontalAlignment="Left"
                Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Content="查询"
                Command="{Binding QueryDataCommand}" />
            <Button
                Margin="8,0,0,0"
                Content="导出"
                Command="{Binding ExportCommand}" />
        </WrapPanel>
        <tm:TmPagination DockPanel.Dock="Bottom" Pagination="{Binding Pagination}" />
        <DataGrid
            ItemsSource="{Binding Pagination.Rows}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                <DataGridTextColumn Header="产品码" Binding="{Binding ProductCode}" Width="*" />
                <DataGridTextColumn Header="需拆标记" Binding="{Binding UnScrewCaves}" Width="*" />
                <DataGridTextColumn Header="位置" Binding="{Binding Locations}" Width="*" />
                <DataGridTextColumn Header="穴位结果" Binding="{Binding ResultJson}" Width="2*" />
                <DataGridTextColumn Header="下线状态" Binding="{Binding Status}" Width="90" />
                <DataGridTextColumn
                    Header="上料时间"
                    Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm:ss}"
                    Width="170" />
                <DataGridTextColumn
                    Header="更新时间"
                    Binding="{Binding UpdateTime, StringFormat=yyyy-MM-dd HH:mm:ss}"
                    Width="170" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
