<UserControl x:Class="Tm.Ant.Module.Rework.Views.CommConfig"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel IsEnabled="{Binding IsEnabled}">
                <WrapPanel>
                    <TextBlock Text="Scanner IP:" VerticalAlignment="Center"/>
                    <hc:TextBox Text="{Binding Scanner.Ip}" MinWidth="215" />
                    <hc:NumericUpDown Value="{Binding Scanner.Port}" MinWidth="60" Margin="5 0"/>
                    <Button Content="Test" Command="{Binding  TestCmd}" CommandParameter="{Binding Scanner}"/>
                </WrapPanel>
                <WrapPanel Margin="0 40 0 10">
                    <TextBlock Text="1#Screw IP:" VerticalAlignment="Center"/>
                    <hc:TextBox Text="{Binding FirstScrew.Ip,Mode=TwoWay}" MinWidth="215" />
                    <hc:NumericUpDown Value="{Binding FirstScrew.Port}" MinWidth="60" Margin="5 0"/>
                    <Button Content="Test" Command="{Binding  TestCmd}" CommandParameter="{Binding FirstScrew}"/>
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="2#Screw IP:" VerticalAlignment="Center"/>
                    <hc:TextBox Text="{Binding SecondScrew.Ip,Mode=TwoWay}" MinWidth="215" />
                    <hc:NumericUpDown Value="{Binding SecondScrew.Port}" MinWidth="60" Margin="5 0"/>
                    <Button Content="Test" Command="{Binding  TestCmd}" CommandParameter="{Binding SecondScrew}"/>
                </WrapPanel>
            </StackPanel>

            <WrapPanel HorizontalAlignment="Center" Margin="0 20 0 0">
                <Button Content="Reset" Command="{Binding ExecuteCmd}" CommandParameter="reset"/>
                <Button Content="Save" Margin="10 0 0 0" IsEnabled="{Binding IsEnabled}" Command="{Binding ExecuteCmd}" CommandParameter="save"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
