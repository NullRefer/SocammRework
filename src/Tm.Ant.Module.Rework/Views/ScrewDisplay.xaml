<UserControl
    x:Class="Tm.Ant.Module.Rework.Views.ScrewDisplay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Tm.Ant.Module.Rework.Behaviors"
    xmlns:models="clr-namespace:Tm.Ant.Module.Rework.Models">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="20" FontWeight="SemiBold">
            <Run Text="事件触发时间：" />
            <Run Text="{Binding TriggeredAt, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm:ss.fff, TargetNullValue=等待事件}" />
        </TextBlock>
        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Margin="0,0,24,0" FontSize="18" Text="{Binding ProductCode, StringFormat=PCB码：{0}}" />
            <TextBlock FontSize="18">
                <Run Text="下线时间：" />
                <Run Text="{Binding UnloadTime, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm:ss.fff, TargetNullValue=等待事件}" />
            </TextBlock>
        </WrapPanel>
        <StackPanel Grid.Row="2" Margin="0,8,0,8">
            <WrapPanel>
                <Button Margin="0,0,8,0" Content="开始标定" Command="{Binding StartCalibrationCommand}" />
                <Button Margin="0,0,8,0" Content="取消标定" Command="{Binding CancelCalibrationCommand}" />
                <Button Content="重试保存" Command="{Binding RetrySaveCommand}" />
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="绿色 OK / 红色 NG；未参与穴位不显示标记" />
            </WrapPanel>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Status}" />
            <TextBlock Foreground="Gray" Text="下线时间为结果取得时刻，不表示SFC上传或软下线已经成功。" />
        </StackPanel>
        <Viewbox Grid.Row="3" Stretch="Uniform">
            <Grid
                Width="{x:Static models:ScrewDisplayGeometry.ImageWidth}"
                Height="{x:Static models:ScrewDisplayGeometry.ImageHeight}"
                Background="Transparent"
                ClipToBounds="True"
                behaviors:ScrewCalibrationBehavior.ClickCommand="{Binding AddPointCommand}">
                <Image Source="../Images/PCB.png" Stretch="Fill" />
                <ItemsControl ItemsSource="{Binding Markers}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="56" Height="40" CornerRadius="20" BorderBrush="White" BorderThickness="2">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-28" Y="-20" />
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#AD7300" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Result}" Value="OK">
                                                <Setter Property="Background" Value="DarkGreen" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Result}" Value="NG">
                                                <Setter Property="Background" Value="Red" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    Text="{Binding Label}"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
