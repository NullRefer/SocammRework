<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <ApplicationIcon>App.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Tm.Ant.Module.Rework/Tm.Ant.Module.Rework.csproj" />
        <Content Include="App.ico" />
        <None Update="Config/**/*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Update="Config/appsettings*.json">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </None>
        <RuntimeConfigTemplate Include="$(MSBuildProjectDirectory)/Config/appsettings*.json" />
    </ItemGroup>
    <Target Name="InitializeLocalDatabase" AfterTargets="Build">
        <MakeDir Directories="$(OutDir)Config" />
        <Copy SourceFiles="%(RuntimeConfigTemplate.Identity)"
            DestinationFiles="$(OutDir)Config/%(RuntimeConfigTemplate.Filename)%(RuntimeConfigTemplate.Extension)"
            Condition="!Exists('$(OutDir)Config/%(RuntimeConfigTemplate.Filename)%(RuntimeConfigTemplate.Extension)')" />
        <Copy SourceFiles="../../assets/seed/rework.db" DestinationFiles="$(OutDir)Config/rework.db"
            Condition="!Exists('$(OutDir)Config/rework.db')" />
    </Target>
    <Target Name="InitializePublishedDatabase" AfterTargets="Publish">
        <MakeDir Directories="$(PublishDir)Config" />
        <Copy SourceFiles="%(RuntimeConfigTemplate.Identity)"
            DestinationFiles="$(PublishDir)Config/%(RuntimeConfigTemplate.Filename)%(RuntimeConfigTemplate.Extension)"
            Condition="!Exists('$(PublishDir)Config/%(RuntimeConfigTemplate.Filename)%(RuntimeConfigTemplate.Extension)')" />
        <Copy SourceFiles="../../assets/seed/rework.db" DestinationFiles="$(PublishDir)Config/rework.db"
            Condition="!Exists('$(PublishDir)Config/rework.db')" />
    </Target>
</Project>
