{
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "throwExceptions": true,
    "internalLogFile": "internal-nlog.log",
    "variables": {
      "logDirectory": "D:\\equipment",
      "logLevel": "Info"
    },
    "targets": {
      "async": true,
      "log": {
        "type": "File",
        "fileName": "${logDirectory}/log/${date:format=yyyy-MM-dd}.log",
        "layout": "${longdate} | ${level:uppercase=true}-${threadid} | ${callsite}:line ${callsite-linenumber} | ${message}${onexception:${NewLine}${exception:format=tostring}}",
        "archiveAboveSize": 52428800
      },
      "oee": {
        "type": "File",
        "fileName": "${logDirectory}/oeelog/${date:format=yyyy-MM-dd}.log",
        "layout": "${longdate} | ${level:uppercase=true}-${threadid} | ${message}${onexception:${NewLine}${exception:format=tostring}}",
        "archiveAboveSize": 52428800
      },
      "phm": {
        "type": "File",
        "fileName": "${logDirectory}/phmlog/${date:format=yyyy-MM-dd}.log",
        "layout": "${longdate} | ${level:uppercase=true}-${threadid} | ${message}${onexception:${NewLine}${exception:format=tostring}}",
        "archiveAboveSize": 52428800
      },
      "sfc": {
        "type": "File",
        "fileName": "${logDirectory}/sfclog/${date:format=yyyy-MM-dd}.log",
        "layout": "${longdate} | ${level:uppercase=true}-${threadid} | ${message}${onexception:${NewLine}${exception:format=tostring}}",
        "archiveAboveSize": 52428800
      }
    },
    "rules": [
      {
        "logger": "Microsoft.EntityFrameworkCore.*",
        "minLevel": "Warn",
        "writeTo": "log",
        "final": true
      },
      {
        "logger": "Microsoft.EntityFrameworkCore.*",
        "minLevel": "Trace",
        "final": true
      },
      {
        "logger": "OEE",
        "minLevel": "${logLevel}",
        "writeTo": "oee",
        "final": true
      },
      {
        "logger": "OEE",
        "minLevel": "Trace",
        "final": true
      },
      {
        "logger": "PHM",
        "minLevel": "${logLevel}",
        "writeTo": "phm",
        "final": true
      },
      {
        "logger": "PHM",
        "minLevel": "Trace",
        "final": true
      },
      {
        "logger": "SFC",
        "minLevel": "${logLevel}",
        "writeTo": "sfc"
      },
      {
        "logger": "System.Net.Http.HttpClient*",
        "minLevel": "Info",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "${logLevel}",
        "writeTo": "log",
        "final": true
      }
    ]
  }
}